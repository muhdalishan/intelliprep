# Copy to .env and fill in. Never commit .env.

ENVIRONMENT=local
# JSON list of allowed browser origins
CORS_ORIGINS=["http://localhost:3000"]

# Supabase project (Settings -> Database -> Connection string, use the asyncpg form)
# Use "local" for a Postgres on this machine before the Supabase project exists
DATABASE_URL=postgresql+asyncpg://postgres:password@db.your-project.supabase.co:5432/postgres
SUPABASE_URL=https://your-project.supabase.co

# Background jobs (Upstash free tier works for development)
REDIS_URL=redis://localhost:6379/0

# AI provider: backend only, never in the frontend
LLM_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
