# Copy to .env.local (or set these in Netlify). Only VITE_* variables reach the browser, so never
# put secrets here: the Supabase anon key is public by design, the service-role key is not.
VITE_API_URL=http://localhost:8000/api

# Supabase -> Project Settings -> API. Leave both empty to run without real accounts (local only).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
